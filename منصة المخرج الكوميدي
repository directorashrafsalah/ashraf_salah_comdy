منصة المخرج الكوميدي أشرف صلاح — نسخة تجريبية مجانية
1) افتح index.html في المتصفح.
2) ضع صور البوسترات والفيديوهات داخل assets لاحقًا.
3) يمكن استبدال كروت المحتوى الوهمية ببيانات الأفلام والبرامج الحقيقية.
4) ربط الاشتراك والدفع والاستضافة يتم في المرحلة التالية.

const modal=document.getElementById('modal'), modalContent=document.getElementById('modalContent');
function showSubscription(){modalContent.innerHTML=`<h2>👑 اشترك في منصة أشرف صلاح</h2><p>ابدأ بالباقة الشهرية وشاهد المحتوى الكوميدي الحصري.</p><div style="font-size:34px;color:#f2bd38;font-weight:800">20 جنيه / شهر</div><button class="primary" onclick="alert('هذه نسخة تجريبية — سيتم ربط الدفع في المرحلة التالية');closeModal()">متابعة الاشتراك</button>`;modal.classList.add('show');}
function watch(title){modalContent.innerHTML=`<h2>🎬 ${title}</h2><p>هذه مساحة تشغيل الفيديو. عند رفع أفلامك وبرامجك سنضع رابط الفيديو أو ملف المشاهدة هنا.</p><button class="primary" onclick="closeModal()">رجوع</button>`;modal.classList.add('show');}
function closeModal(){modal.classList.remove('show')}
document.querySelectorAll('.cat').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.cat').forEach(b=>b.classList.remove('active'));btn.classList.add('active');const f=btn.dataset.filter;document.querySelectorAll('.card').forEach(c=>c.style.display=(f==='all'||c.dataset.type===f)?'block':'none')}));

